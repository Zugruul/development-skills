#!/usr/bin/env bash
# Hermetic stand-in for the herdr CLI, in bash + jq. State lives in $HERDR_STUB_DIR/state.json:
#   {"agents": {key: {...agent fields, "script": [states], "screen": "..."}}, "busy": N,
#    "start": "ok|not_ready", "prompt": "ok|silent|stalled|blocked",
#    "workspaces": [...], "worktrees": [...], "root": "/repo"}
# Every call is appended to $HERDR_STUB_DIR/calls.log.
set -uo pipefail
d="${HERDR_STUB_DIR:?HERDR_STUB_DIR is not set}"
state="$d/state.json"
[ -s "$state" ] || printf '{}' >"$state"
printf '%s\n' "$*" >>"$d/calls.log"

st() { jq -c '.agents //= {}' "$state"; }
save() { # json
    printf '%s' "$1" >"$state.tmp" && mv "$state.tmp" "$state"
}
ok() { # result json
    jq -cn --argjson r "$1" '{id: "stub", result: $r}'
    exit 0
}
fail() { # code [message]
    jq -cn --arg c "$1" --arg m "${2:-stub}" '{id: "stub", error: {code: $c, message: $m}}' >&2
    exit 1
}
opt() { # name args... -> value after name
    local want="$1"
    shift
    while [ $# -gt 0 ]; do
        [ "$1" = "$want" ] && { printf '%s' "${2:-}"; return 0; }
        shift
    done
    return 1
}
# The key of the agent whose name or pane id is $1, or nothing.
find_key() {
    st | jq -r --arg t "$1" '.agents | to_entries[] | select(.value.name == $t or .value.pane_id == $t) | .key' | head -1
}

[ "$*" = "--version" ] && { echo "herdr 0.0.0-stub"; exit 0; }
# `agent start --help` lists the supported kinds, as the real CLI does; HERDR_STUB_KINDS overrides them.
if [ "${1:-} ${2:-} ${3:-}" = "agent start --help" ]; then
    printf "      --kind <KIND>\n          Supported agent kind and canonical executable\n\n          [possible values: %s]\n" "${HERDR_STUB_KINDS:-pi, claude, codex, gemini, opencode}"
    exit 0
fi
cmd="${1:-} ${2:-}"
case "$cmd" in
    "agent list") ok "$(st | jq -c '{agents: [.agents[]]}')" ;;
    "workspace list") ok "$(st | jq -c '{workspaces: (.workspaces // [])}')" ;;
    "workspace close")
        # Closes the workspace with every agent in it. state.workspace_close = "fail" refuses.
        [ "$(st | jq -r '.workspace_close // "ok"')" = ok ] || fail workspace_group_close_required "refused"
        save "$(st | jq -c --arg w "${3:-}" '.workspaces_closed += [$w]
            | .agents |= with_entries(select(.value.workspace_id != $w))
            | .workspaces = [(.workspaces // [])[] | select(.workspace_id != $w)]')"
        ok '{"type":"workspace_closed"}' ;;
    "worktree list")
        root="$(st | jq -r '.root // ""')"
        ok "$(st | jq -c --arg r "$root" --arg n "$(basename "$root")" \
            '{type: "worktree_list", worktrees: (.worktrees // []), source: {repo_root: $r, repo_name: $n, source_checkout_path: $r}}')" ;;
    "agent rename")
        k="$(find_key "$3")"
        [ -n "$k" ] || fail agent_not_found
        save "$(st | jq -c --arg k "$k" --arg n "$4" '.agents[$k].name = $n')"
        ok '{"type":"agent_renamed"}' ;;
    "agent get")
        k="$(find_key "$3")"
        [ -n "$k" ] || fail agent_not_found
        # A scripted sequence of states, one per `get`, lets a test move an agent along.
        new="$(st | jq -c --arg k "$k" '
            if ((.agents[$k].script // []) | length) > 0 then
                .agents[$k].agent_status = .agents[$k].script[0]
                | .agents[$k].script |= .[1:]
                | .agents[$k].state_change_seq = ((.agents[$k].state_change_seq // 0) + 1)
            else . end')"
        save "$new"
        ok "$(printf '%s' "$new" | jq -c --arg k "$k" '{type: "agent", agent: .agents[$k]}')" ;;
    "agent read")
        k="$(find_key "$3")"
        scr=""
        [ -n "$k" ] && scr="$(st | jq -r --arg k "$k" '.agents[$k].screen // ""')"
        printf 'SCREEN[%s]\n%s\n' "$(opt --source "$@")" "$scr"
        exit 0 ;;
    "agent start")
        busy="$(st | jq -r '.busy // 0')"
        if [ "$busy" -gt 0 ]; then
            save "$(st | jq -c '.busy -= 1')"
            fail agent_pane_busy
        fi
        name="$3" pane="$(opt --pane "$@")" kind="$(opt --kind "$@")"
        # state.resume = "fail": a start that passes native arguments after -- (a resume) fails
        case " $* " in *" -- "*) [ "$(st | jq -r '.resume // "ok"')" = ok ] || fail agent_start_failed "no such session" ;; esac
        mode="$(st | jq -r '.start // "ok"')"
        new="$(st | jq -c --arg n "$name" --arg p "$pane" --arg k "$kind" --arg m "$mode" '
            .agents[$n] = {name: $n, pane_id: $p, tab_id: (($p | split(":")[0]) + ":t1"),
                           workspace_id: ($p | split(":")[0]), agent: $k,
                           agent_status: (if $m == "not_ready" then "blocked" else "idle" end),
                           state_change_seq: 1, cwd: "/w",
                           screen: (if $m == "not_ready" then "Do you trust this folder?" else "" end)}')"
        save "$new"
        [ "$mode" = "not_ready" ] && fail agent_not_ready
        ok "$(printf '%s' "$new" | jq -c --arg n "$name" '{type: "agent_started", agent: .agents[$n]}')" ;;
    "agent prompt")
        k="$(find_key "$3")"
        [ -n "$k" ] || fail agent_not_found
        mode="$(st | jq -r '.prompt // "ok"')"
        [ "$mode" = "blocked" ] && fail agent_blocked
        [ "$mode" = "stalled" ] && fail agent_prompt_stalled
        new="$(st | jq -c --arg k "$k" --arg m "$mode" --arg t "${4:-}" '
            if $m == "ok" then .agents[$k].agent_status = "working"
                | .agents[$k].state_change_seq = ((.agents[$k].state_change_seq // 0) + 1) else . end
            | .agents[$k].last_prompt = $t')"
        save "$new"
        ok '{"type":"prompt_submitted"}' ;;
    "pane run")
        # Records the typed text. With state.pane_exec true the stub's "shell" runs it for real,
        # detached, in the caller's directory, its output appended to $HERDR_STUB_DIR/pane-<pane>.out
        # (what `pane read` and `pane wait-output` see, after any state.panes[p].lines).
        pane="$3" text="${4:-}"
        save "$(st | jq -c --arg p "$pane" --arg t "$text" '.panes[$p].typed += [$t]')"
        if [ "$(st | jq -r '.pane_exec // false')" = true ]; then
            nohup bash -c "$text" >>"$d/pane-${pane//[^A-Za-z0-9]/_}.out" 2>&1 </dev/null &
        fi
        ok '{"type":"pane_run"}' ;;
    "pane read")
        pane="$3"
        { st | jq -r --arg p "$pane" '.panes[$p].lines // [] | .[]'; cat "$d/pane-${pane//[^A-Za-z0-9]/_}.out" 2>/dev/null; } | tail -n "$(opt --lines "$@" || echo 1000)"
        exit 0 ;;
    "pane wait-output")
        pane="$3" re="$(opt --regex "$@")"
        hit="$({ st | jq -r --arg p "$pane" '.panes[$p].lines // [] | .[]'; cat "$d/pane-${pane//[^A-Za-z0-9]/_}.out" 2>/dev/null; } | grep -E -- "$re" | tail -1)"
        [ -n "$hit" ] || fail timeout "no match"
        ok "$(jq -cn --arg p "$pane" --arg l "$hit" '{type: "pane_output_matched", pane_id: $p, matched_line: $l}')" ;;
    "plugin pane")
        case "${3:-}" in
            open)
                ep="$(opt --entrypoint "$@")" target="$(opt --target-pane "$@")"
                [ "$(st | jq -r '.plugin_open // "ok"')" = "fail" ] && fail plugin_pane_open_failed
                # The new pane joins pane_list in the target's tab, untitled (its title comes later).
                save "$(st | jq -c --arg e "$ep" --arg t "$target" '
                    ([(.pane_list // [])[] | select(.pane_id == $t)][0].tab_id // ([(.agents // {})[] | select(.pane_id == $t)][0].tab_id) // "w1:t1") as $tab
                    | .opened += [{entrypoint: $e, target: $t}]
                    | if $e == "panel" then .pane_list = ((.pane_list // []) + [{pane_id: "w9:p9", tab_id: $tab}]) else . end')"
                ok "$(jq -cn --arg e "$ep" '{type: "plugin_pane_opened", plugin_pane: {entrypoint: $e, pane: {pane_id: "w9:p9"}}}')" ;;
            close)
                save "$(st | jq -c --arg p "${4:-}" '.closed += [$p] | .pane_list |= map(select(.pane_id != $p))')"
                ok '{"type":"plugin_pane_closed"}' ;;
        esac ;;
    "pane list") ok "$(st | jq -c '{panes: (.pane_list // [])}')" ;;
    "pane get")
        p="$(st | jq -c --arg p "$3" '[(.pane_list // [])[] | select(.pane_id == $p)][0] // {pane_id: $p, tab_id: "w1:t1"}')"
        ok "$(jq -cn --argjson p "$p" '{type: "pane", pane: $p}')" ;;
    "pane send-text")
        save "$(st | jq -c --arg p "$3" --arg t "${4:-}" '.sent += [{pane: $p, text: $t}]')"
        ok '{"type":"pane_send_text"}' ;;
    "agent focus")
        save "$(st | jq -c --arg a "$3" '.focused += [$a]')"
        ok '{"type":"agent_focused"}' ;;
    "pane report-metadata")
        save "$(st | jq -c --arg p "$3" --arg all "$*" '.tokens += [{pane: $p, args: $all}]')"
        ok '{"type":"pane_metadata_reported"}' ;;
    "worktree remove")
        # state.worktree_remove = "fail" makes the removal fail, as for a dirty checkout.
        [ "$(st | jq -r '.worktree_remove // "ok"')" = ok ] || fail worktree_dirty "the checkout has changes"
        w="$(opt --workspace "$@")"
        # a workspace that names its checkout: the worktree really goes, never with --force
        root="$(st | jq -r --arg w "$w" '[(.workspaces // [])[] | select(.workspace_id == $w) | .worktree.repo_root // empty][0] // empty')"
        co="$(st | jq -r --arg w "$w" '[(.workspaces // [])[] | select(.workspace_id == $w) | .worktree.checkout_path // empty][0] // empty')"
        if [ -n "$root" ] && [ -d "$co" ]; then
            err="$(git -C "$root" worktree remove "$co" 2>&1)" || fail worktree_dirty "$err"
        fi
        save "$(st | jq -c --arg w "$w" '.worktrees_removed += [$w] | .workspaces = [(.workspaces // [])[] | select(.workspace_id != $w)]')"
        ok '{"type":"worktree_removed"}' ;;
    "worktree open")
        # state.worktree_open = "fail" refuses. Opens workspace w-open<n> with one pane on --path.
        [ "$(st | jq -r '.worktree_open // "ok"')" = ok ] || fail worktree_open_failed "refused"
        new="$(st | jq -c --arg r "$(opt --cwd "$@")" --arg c "$(opt --path "$@")" '
            ((.opens // 0) + 1) as $n | "w-open\($n)" as $w | .opens = $n | .last_open = $w
            | .workspaces = ((.workspaces // []) + [{workspace_id: $w, worktree: {repo_root: $r, checkout_path: $c}}])
            | .pane_list = ((.pane_list // []) + [{pane_id: "\($w):p1", tab_id: "\($w):t1", workspace_id: $w}])')"
        save "$new"
        ok "$(printf '%s' "$new" | jq -c '{type: "worktree_opened", workspace: {workspace_id: .last_open}, root_pane: {pane_id: "\(.last_open):p1"}}')" ;;
    "worktree create")
        # state.worktree_create = "fail" refuses. Adds a real worktree of an existing --branch on
        # --path and opens workspace w-new<n> on it.
        [ "$(st | jq -r '.worktree_create // "ok"')" = ok ] || fail worktree_create_failed "refused"
        root="$(opt --cwd "$@")" co="$(opt --path "$@")"
        err="$(git -C "$root" worktree add -q "$co" "$(opt --branch "$@")" 2>&1)" || fail worktree_create_failed "$err"
        new="$(st | jq -c --arg r "$root" --arg c "$co" '
            ((.creates // 0) + 1) as $n | "w-new\($n)" as $w | .creates = $n | .last_open = $w
            | .workspaces = ((.workspaces // []) + [{workspace_id: $w, worktree: {repo_root: $r, checkout_path: $c}}])
            | .pane_list = ((.pane_list // []) + [{pane_id: "\($w):p1", tab_id: "\($w):t1", workspace_id: $w}])')"
        save "$new"
        ok "$(printf '%s' "$new" | jq -c '{type: "worktree_created", workspace: {workspace_id: .last_open}, root_pane: {pane_id: "\(.last_open):p1"}}')" ;;
    # Tabs live in state.tabs, keyed by tab id; `tab close` removes one and records it in
    # state.tabs_closed (the call is in calls.log too).
    "tab create")
        # A new tab gets tab id <ws>:t<n> and a root pane <ws>:p<n+10>, so the two ids differ.
        w="$(opt --workspace "$@")"
        new="$(st | jq -c --arg w "$w" '
            ([(.tabs // {})[] | select(.workspace_id == $w)] | length + 2) as $n
            | {tab_id: "\($w):t\($n)", workspace_id: $w, number: $n, agent_status: "unknown", label: "x"} as $t
            | .tabs[$t.tab_id] = $t
            | .pane_list += [{pane_id: "\($w):p\($n + 10)", tab_id: $t.tab_id, workspace_id: $w}]
            | .last_tab = $t | .last_pane = "\($w):p\($n + 10)"')"
        save "$new"
        ok "$(printf '%s' "$new" | jq -c '{type: "tab_created", tab: .last_tab, root_pane: {pane_id: .last_pane}}')" ;;
    "tab get")
        t="$(st | jq -c --arg t "${3:-}" '(.tabs // {})[$t] // empty')"
        [ -n "$t" ] || fail tab_not_found "tab ${3:-} not found"
        ok "$(jq -cn --argjson t "$t" '{type: "tab_info", tab: $t}')" ;;
    "tab close")
        st | jq -e --arg t "${3:-}" '(.tabs // {}) | has($t)' >/dev/null || fail tab_not_found "tab ${3:-} not found"
        save "$(st | jq -c --arg t "${3:-}" 'del(.tabs[$t]) | .tabs_closed += [$t]')"
        ok '{"type":"tab_closed"}' ;;
    "config check")
        if [ "$(st | jq -r '.config_check // "ok"')" = "fail" ]; then echo "config: issues found"; exit 1; fi
        echo "config: ok"
        exit 0 ;;
    "notification show")
        save "$(st | jq -c --arg t "${3:-}" '.notified += [$t]')"
        # state.notify = "disabled" shows nothing, with exit 0, as a default Herdr config does
        [ "$(st | jq -r '.notify // "ok"')" != disabled ] || ok '{"type":"notification_show","shown":false,"reason":"disabled"}'
        ok '{"type":"notification_show","shown":true}' ;;
esac
fail stub_unsupported "$cmd"
